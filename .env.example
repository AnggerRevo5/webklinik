# Salin file ini jadi .env lalu isi nilainya
# Windows (PowerShell/CMD): copy .env.example .env
# Mac/Linux/Git Bash:       cp .env.example .env

# ===== WAJIB DIISI =====

# Password MySQL (bebas, tapi harus diisi)
MYSQL_ROOT_PASSWORD=isi_password_bebas_disini

# Tidak perlu diubah (user tambahan tidak dipakai)
MYSQL_USER=
MYSQL_PASSWORD=

# ===== OPSIONAL (fitur foto tidak akan jalan tanpa ini) =====

# Daftar gratis di cloudinary.com lalu copy dari dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== AUTH =====

# Bebas isi string random, misal: klinik_rahasia_2025
JWT_SECRET=isi_secret_random_disini
